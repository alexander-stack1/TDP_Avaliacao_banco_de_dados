# Referência de variáveis nativas do PostgreSQL. Os scripts NÃO carregam .env.
# Para execução manual, exporte as variáveis necessárias na sessão do terminal.
# Prefira prompt de senha ou .pgpass; não grave senhas neste arquivo.
# A validação isolada (scripts/validar.sh) não usa estas configurações.
PGHOST=localhost
PGPORT=5432
PGDATABASE=bolsa_valores
PGUSER=usuario_do_banco
